# Configuración del Motor de Base de Datos (sqlite | postgres | mysql)
DB_ENGINE=sqlite
DB_SOFT_DELETE=true
DB_FILE=database.sqlite

# Configuración si se usa Postgres o MySQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=login_db

# Seguridad de Tokens y Sesiones
JWT_ACCESS_SECRET=cambiar_en_produccion_secreto_access
JWT_REFRESH_SECRET=cambiar_en_produccion_secreto_refresh
COOKIE_SECRET=cambiar_en_produccion_secreto_cookie
SESSION_EXPIRES_DAYS=30

# URL Base del Frontend (utilizada para generar enlaces en correos electrónicos de bienvenida y restablecimiento)
# Por defecto Vite inicia en 5173. Si dicho puerto está ocupado en tu equipo local, indícalo aquí (ej. 5176).
FRONTEND_URL=http://localhost:5173

# Configuración de Plantillas y Correo Electrónico
# Proveedores comunes:
# - Mailtrap: host=sandbox.smtp.mailtrap.io port=2525 secure=false
# - Gmail: host=smtp.gmail.com port=465 secure=true (usar contraseña de aplicación de 16 letras)
# - Brevo / Sendinblue: host=smtp-relay.brevo.com port=587 secure=false
# - Resend / SendGrid / Custom: según los datos provistos
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_o_token_smtp

# Remitentes independientes por plantilla
MAIL_FROM_WELCOME="Bienvenido al Sistema <bienvenida@tudominio.com>"
MAIL_FROM_RESET="Seguridad y Recuperación <seguridad@tudominio.com>"
MAIL_FROM_ALERT="Alertas de Cuenta <alertas@tudominio.com>"

# Google OAuth (Opcional)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
