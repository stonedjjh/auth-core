# Configuración del Motor de Base de Datos (sqlite | postgres | mysql)
DB_ENGINE=sqlite
DB_SOFT_DELETE=true
DB_FILE=database.sqlite

# Configuración si se usa Postgres o MySQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=login_db

# Seguridad de Tokens y Sesiones
JWT_ACCESS_SECRET=cambiar_en_produccion_secreto_access
JWT_REFRESH_SECRET=cambiar_en_produccion_secreto_refresh
COOKIE_SECRET=cambiar_en_produccion_secreto_cookie
SESSION_EXPIRES_DAYS=30

# Configuración de Plantillas y Correo Electrónico
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp

# Remitentes independientes por plantilla
MAIL_FROM_WELCOME="Bienvenido al Sistema <bienvenida@tudominio.com>"
MAIL_FROM_RESET="Seguridad y Recuperación <seguridad@tudominio.com>"
MAIL_FROM_ALERT="Alertas de Cuenta <alertas@tudominio.com>"

# Google OAuth (Opcional)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
